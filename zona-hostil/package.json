{
  "name": "zona-hostil",
  "private": true,
  "version": "0.1.0",
  "description": "ZONA HOSTIL — FPS/TPS Battle Royale 3D (Three.js + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
